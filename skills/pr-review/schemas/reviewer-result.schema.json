{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/justinramel/review-skills/pr-review/schemas/reviewer-result.schema.json",
  "title": "PR review verdict result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "files",
    "verdict",
    "runtime",
    "findings"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "enum": [
        "approve",
        "approve-with-nits",
        "request-changes"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "effort"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "location",
          "summary",
          "evidence",
          "fix"
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "nit"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "fix": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
